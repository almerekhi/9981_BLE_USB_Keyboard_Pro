/*
 * P9981 Arabic - Photo Match Edition
 * Based on user uploaded image
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define SYM     1
#define FUNC    2
#define ARABIC  3

/ {
    behaviors {
        /*
         * برمجة الأزرار المزدوجة بناءً على الصورة
         * Tap (ضغطة سريعة) = الحرف الكبير الملون
         * Hold (ضغطة مطولة) = الحرف الصغير (أو المخفي)
         */

        // زر D: في الصورة عليه (ي) كبير و (د) صغير
        ar_d: ar_d { compatible = "zmk,behavior-hold-tap"; label = "AR_D"; #binding-cells = <2>; tapping-term-ms = <200>; quick-tap-ms = <0>; flavor = "tap-preferred"; bindings = <&kp>, <&kp>; };

        // زر J: في الصورة عليه (ت) كبير و (ج) صغير
        ar_j: ar_j { compatible = "zmk,behavior-hold-tap"; label = "AR_J"; #binding-cells = <2>; tapping-term-ms = <200>; quick-tap-ms = <0>; flavor = "tap-preferred"; bindings = <&kp>, <&kp>; };

        // زر V: في الصورة عليه (ر) كبير و (ز) صغير
        ar_v: ar_v { compatible = "zmk,behavior-hold-tap"; label = "AR_V"; #binding-cells = <2>; tapping-term-ms = <200>; quick-tap-ms = <0>; flavor = "tap-preferred"; bindings = <&kp>, <&kp>; };

        // زر السماعة ($): في الصورة عليه (ط) كبير و (ظ) صغير
        ar_dol: ar_dol { compatible = "zmk,behavior-hold-tap"; label = "AR_DOL"; #binding-cells = <2>; tapping-term-ms = <200>; quick-tap-ms = <0>; flavor = "tap-preferred"; bindings = <&kp>, <&kp>; };

        // إضافات ذكية للحروف غير المطبوعة (لأنها ضرورية)
        // زر W: عليه (ص) فقط -> المطول يعطيك (و)
        ar_w: ar_w { compatible = "zmk,behavior-hold-tap"; label = "AR_W"; #binding-cells = <2>; tapping-term-ms = <200>; quick-tap-ms = <0>; flavor = "tap-preferred"; bindings = <&kp>, <&kp>; };
        // زر E: عليه (ث) فقط -> المطول يعطيك (ذ)
        ar_e: ar_e { compatible = "zmk,behavior-hold-tap"; label = "AR_E"; #binding-cells = <2>; tapping-term-ms = <200>; quick-tap-ms = <0>; flavor = "tap-preferred"; bindings = <&kp>, <&kp>; };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: English (كما هي) */
        default_layer {
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp BSPC
                &lt SYM SPACE &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &lt FUNC ENTER
                &kp LSHFT &tog ARABIC &kp LGUI &kp LALT &kp RSHFT
            >;
        };

        /* Layer 1: Symbols (كما هي) */
        sym_layer {
            bindings = <
                &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0
                &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp STAR &kp LPAR &kp BSPC
                &trans   &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp SEMI &kp APOS &trans
                &trans   &trans   &trans   &trans   &trans
            >;
        };

        /* Layer 2: Functions (كما هي) */
        func_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &bootloader
                &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &sys_reset
                &trans   &kp F10  &kp F11  &kp F12  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans &trans
                &trans   &bt BT_CLR &trans &trans   &trans
            >;
        };

        /* Layer 3: ARABIC (Photo Matched) */
        arabic_layer {
            bindings = <
                /* الصف الأول: Q=ض, W=ص(و), E=ث(ذ), R=ق, T=ف, Y=غ, U=ع, I=هـ, O=خ, P=ح */
                &kp Q        &ar_w COMMA W &ar_e GRAVE E &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P
                
                /* الصف الثاني: A=ش, S=س, D=ي(د), F=ب, G=ل, H=ا, J=ت(ج), K=ن, L=م, Del=ك */
                &kp A        &kp S         &ar_d RBKT D  &kp F      &kp G      &kp H      &ar_j LBKT J &kp K    &kp L      &kp SEMI
                
                /* الصف الثالث: Z=ئ, X=ء, C=ؤ, V=ر(ز), B=لا, N=ى, M=ة, Speaker=ط(ظ) */
                &kp SPACE    &kp Z         &kp X         &kp C      &ar_v DOT V &kp B     &kp N      &kp M      &ar_dol FSLH APOS
                
                /* الصف الرابع */
                &kp LSHFT    &tog ARABIC   &kp LGUI      &kp LALT   &kp RSHFT
            >;
        };
    };
};
